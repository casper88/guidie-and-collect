{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guidie-and-collect/schema/guidance_plan.schema.json",
  "title": "Guidance Plan",
  "description": "A factory-authored task definition. Doubles as the annotation schema: every step's instruction becomes a language label, and success_criterion drives automatic segmentation and outcome labeling.",
  "type": "object",
  "required": ["plan_id", "version", "task_name", "objects", "steps"],
  "additionalProperties": false,
  "properties": {
    "plan_id": { "type": "string", "pattern": "^[a-zA-Z0-9_]+$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "task_name": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "default": "zh-TW" },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["object_id", "name"],
        "additionalProperties": false,
        "properties": {
          "object_id": { "type": "string", "pattern": "^[a-zA-Z0-9_]+$" },
          "name": { "type": "string" },
          "model_ref": { "type": "string" }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["step_id", "order", "type", "instruction", "target", "success_criterion"],
        "additionalProperties": false,
        "properties": {
          "step_id": { "type": "string", "pattern": "^[a-zA-Z0-9_]+$" },
          "order": { "type": "integer", "minimum": 1 },
          "type": { "type": "string", "enum": ["insert", "fasten", "place", "route", "inspect"] },
          "instruction": { "type": "string", "minLength": 1 },
          "target": {
            "type": "object",
            "required": ["object_id", "point_id"],
            "additionalProperties": false,
            "properties": {
              "object_id": { "type": "string" },
              "point_id": { "type": "string" }
            }
          },
          "success_criterion": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "type": "string", "enum": ["force_threshold", "click_detected", "pose_match", "manual_confirm"] },
              "force_n": { "type": "number", "minimum": 0 },
              "tolerance_mm": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    }
  }
}
